# Smart Resume Screener Configuration
# Copy this file to .env to configure custom settings or enable LLM evaluation

DATABASE_PATH=data/screener.db
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=10

# Optional LLM Configuration (OpenAI, Groq, Ollama, DeepSeek, Google Gemini OpenAI-compatible endpoints)
# When omitted, the screener seamlessly operates in deterministic rule-based explainability mode.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
